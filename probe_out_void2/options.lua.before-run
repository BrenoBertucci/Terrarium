    ["YoDrehDenSwagAuf/overworld-spawn-mod"] = {
      checkedAt = 1786303481,
      latest = "1.12.1",
      releases = {
        [1] = {
          body = "A minor update to fix a couple minor issues I had initially missed.\13\
\13\
### What's New\13\
- Mod sub-menus now support controller.\13\
- The 'A' button will increment/cycle through sub-menu options.\13\
- Removes the duplicate \"FOLLOWER\" option in party menu.\13\
- Replaces \"FOLLOWER\"/\"FOLLOWING\" with \"FOLLOW\"/\"DISMISS\".\13\
\13\
### Compatibility\13\
Pokémon Red\13\
Pokémon Blue\13\
Pokémon Yellow\13\
Dramatic Shape Voxel Mod\13\
Kanto in First Person\13\
BATTLE ART - bring your own sprites!",
          downloads = 1081,
          name = "Wilds of Kanto v1.12.1",
          prerelease = false,
          published = "2026-08-09",
          tag = "v1.12.1",
