    ["eduardocalafell/gen1recomp-auto-battle"] = {
      checkedAt = 1786303476,
      latest = "0.1.9",
      releases = {
        [1] = {
          body = "**Buff / Debuff.** New option **USE BUFF/DEBUFF** (default OFF): spends a turn on a stat move (Swords Dance, Growl, …) only when it's safe and worth it — you can damage but can't OHKO, the foe is healthy, and you survive its worst hit — capped at +/-2 so it never sets up forever.\
\
**Auto Catch fixes.** No longer wastes turns on an immune move: it weakens only with a move that actually connects (e.g. it won't spam Electric attacks at a Ground-type Rhyhorn), picks the lowest real-damage move, and skips status moves whose type is immune (Thunder Wave vs Ground). When nothing can safely weaken, it just throws the ball.\
\
**Install:** launcher → MODS → Import mod .zip → `auto_battle-0.1.9.zip`, then enable it.",
          downloads = 158,
          name = "Auto Battle v0.1.9",
          prerelease = false,
          published = "2026-08-07",
          tag = "v0.1.9",
          version = "0.1.9",
          zip = {
            name = "auto_battle-0.1.9.zip",
            size = 13412,
            url = "https://github.com/eduardocalafell/gen1recomp-auto-battle/releases/download/v0.1.9/auto_battle-0.1.9.zip",
          },
        },
        [2] = {
          body = "**Switch Matchup.** New option **SWITCH MATCHUP** (default OFF): before attacking, checks whether a benched Pokemon has a clearly better type matchup — scoring both directions with the real movesets — and switches in when it's worth the free hit. Avoids switch-loops and won't send a mon into a super-effective hit.\
\
Also smarter when your move can't connect (e.g. only Normal moves vs a Ghost): it uses a status/utility move instead of hammering an immune attack, and — with SWITCH MATCHUP on — swaps to a benched mon that can actually hit.\
\
**Install:** launcher → MODS → Import mod .zip → `auto_battle-0.1.7.zip`, then enable it.",
          downloads = 52,
          name = "Auto Battle v0.1.7",
          prerelease = false,
          published = "2026-08-07",
          tag = "v0.1.7",
          version = "0.1.7",
          zip = {
            name = "auto_battle-0.1.7.zip",
            size = 11786,
            url = "https://github.com/eduardocalafell/gen1recomp-auto-battle/releases/download/v0.1.7/auto_battle-0.1.7.zip",
          },
        },
        [3] = {
          body = "**Auto Catch.** New option **AUTO CATCH** (default OFF): in wild battles against a Pokemon not yet in your Pokedex, it sleeps/paralyses the target, weakens it toward half HP with your weakest move — only when a forced-crit damage estimate proves the hit can't KO — then throws a ball (cheapest first) until caught or out.\
\
Safety: never throws a Master or Safari Ball, never touches trainer battles or species you already own, and bails to a throw rather than risk a kill. Runs on the game's own catch path, so the dex and party/box are updated normally.\
\
**Install:** launcher → MODS → Import mod .zip → `auto_battle-0.1.5.zip`, then enable it.",
          downloads = 69,
          name = "Auto Battle v0.1.5",
          prerelease = false,
          published = "2026-08-07",
          tag = "v0.1.5",
          version = "0.1.5",
          zip = {
            name = "auto_battle-0.1.5.zip",
            size = 10144,
            url = "https://github.com/eduardocalafell/gen1recomp-auto-battle/releases/download/v0.1.5/auto_battle-0.1.5.zip",
          },
        },
        [4] = {
          body = "**Auto-heal & cure.** New options: **HEAL ITEMS** (use a Potion when the active Pokemon drops below **HEAL BELOW** — 1/2 or 1/4 HP; picks the smallest potion that covers the missing HP) and **CURE STATUS** (Antidote / Full Heal / etc.). Both spend a turn like a normal bag item and are OFF by default. Badges are now flush to the right edge.\
\
Runs on the game's own item path, so heals persist to your party after battle.\
\
**Install:** launcher → MODS → Import mod .zip → `auto_battle-0.1.4.zip`, then enable it.",
          downloads = 23,
          name = "Auto Battle v0.1.4",
          prerelease = false,
          published = "2026-08-06",
          tag = "v0.1.4",
          version = "0.1.4",
          zip = {
            name = "auto_battle-0.1.4.zip",
            size = 8394,
            url = "https://github.com/eduardocalafell/gen1recomp-auto-battle/releases/download/v0.1.4/auto_battle-0.1.4.zip",
          },
        },
        [5] = {
          body = "Badges now render at integer scale (BADGE SIZE 1X/2X, same technique as the damage_numbers mod) so the text stays pixel-crisp. Adds the **BADGE SIZE** option (default 1X).\
\
Auto-picks the most type-effective move each turn (falls back to the game's NPC AI), optional **Skip Dialogs**, on-screen AUTO/SKIP badges, and a takeover window (nudge the D-pad) for manual switch/item/run/catch.\
\
**Install:** launcher → MODS → Import mod .zip → `auto_battle-0.1.3.zip`, then enable it.",
          downloads = 1,
          name = "Auto Battle v0.1.3",
          prerelease = false,
          published = "2026-08-06",
          tag = "v0.1.3",
          version = "0.1.3",
          zip = {
            name = "auto_battle-0.1.3.zip",
            size = 6704,
            url = "https://github.com/eduardocalafell/gen1recomp-auto-battle/releases/download/v0.1.3/auto_battle-0.1.3.zip",
          },
        },
        [6] = {
