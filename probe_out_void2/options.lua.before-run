        [3] = {
          body = "Looking into the Followers EX mod, I realized they also managed to have unique menu icons without compromising the color palletes by using a monkey-patch and pulling the overworld sprites instead of relying on the actual menu icon's coding. Thanks to that, I was also able to implement said feature, as well as two color variants:\13\
