    ["ShaneMcGovernIE/gen1recomp-widescreen-battle-intro"] = {
      checkedAt = 1786303478,
      latest = "1.5.0",
      releases = {
        [1] = {
          body = "Download the .zip and install it from the game: MODS > Import mod .zip.\
\
## Changes\
\
- **BLACK OUTRO** option in the OPTIONS menu (ON by default): when a battle ends, the screen now fades to black — the battle fades to full black over about 0.6s, the screen cuts behind the black, and the map fades up out of it — instead of the engine's blinding white flash. A loss (the blackout warp to the last Pokemon Center) never used the white flash and is unchanged; turning the option OFF restores the engine's white return exactly.\
- The black outro no longer white-flashes when another mod also replaces the post-battle transition. `dramatic_shape_brick`'s voxel battle exit wraps `BattleState:finish` too, and its wrap pushed its own fade on top of the battle instead of ending it — the battle froze under both fades and popped late, showing the engine's white return. The outro now pops any such foreign fade and re-drives the exit until the battle has really closed behind the black.\
\
## Install\
\
Grab `widescreen_battle_intro-1.5.0.zip` below and import it from the game (MODS > Import mod .zip), or copy the mod folder into the game's `mods/` directory.\
",
          downloads = 3289,
          name = "v1.5.0",
          prerelease = false,
          published = "2026-08-06",
          tag = "v1.5.0",
          version = "1.5.0",
          zip = {
            name = "widescreen_battle_intro-1.5.0.zip",
            size = 13068,
            url = "https://github.com/ShaneMcGovernIE/gen1recomp-widescreen-battle-intro/releases/download/v1.5.0/widescreen_battle_intro-1.5.0.zip",
          },
        },
        [2] = {
          body = "Download the .zip and install it from the game: MODS > Import mod .zip.\
\
## Changes\
\
- The battle flash no longer double-darkens (defers to Renderer.screenVeil); the poison pulse no longer paints over the post-battle white fade.\
- Dropped the Commands.start_battle / old_man_demo overrides the engine now owns via OverworldState:pushBattle.\
- Dead BattleTransition require and defaultFlashless export removed; docs corrected.",
          downloads = 1951,
          name = "1.4.1",
          prerelease = false,
          published = "2026-08-05",
          tag = "v1.4.1",
          version = "1.4.1",
          zip = {
            name = "widescreen_battle_intro-1.4.1.zip",
